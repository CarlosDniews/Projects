generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Student model
model Student {
  id    Int     @id @default(autoincrement())
  ra    String  @unique 
  cpf   String  @unique 
  name  String
  email String
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}